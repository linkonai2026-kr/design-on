    "googleFonts": "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family={FAMILY}:wght@400;700&display=swap\">",
    "fontshare": "<link rel=\"stylesheet\" href=\"https://api.fontshare.com/v2/css?f[]={slug}@{weights}&display=swap\">",
    "fontshareNote": "slug는 소문자 하이픈(clash-display). weights는 쉼표(400,600,700). 예: https://api.fontshare.com/v2/css?f[]=clash-display@400,600&display=swap",
    "preconnect": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>"
